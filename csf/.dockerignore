# Build context is the repo root so the sidecar image can COPY vendor/crs
# directly -- one source of truth for the rule set, rather than a duplicate
# staged into s1-sidecar/. Everything heavy or secret is excluded here.
data/
model/
.venv/
.git/
docs/
*.jsonl
*.pkl
*.onnx
*.pt
.env*
*.pem
*.key
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
