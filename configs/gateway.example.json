{
  "listen_host": "127.0.0.1",
  "listen_port": 8080,
  "upstream": "http://localhost:3000",
  "mode": "shadow",
  "log_level": "info",
  "log_json": true,
  "timeouts": {
    "upstream": 30.0,
    "keep_alive": 5.0
  },
  "limits": {
    "max_body_bytes": 1048576,
    "max_candidates": 256,
    "max_json_depth": 20,
    "max_decode_depth": 3,
    "max_value_bytes": 65536,
    "max_headers": 100,
    "inspect_cookies": false
  },
  "auth": {
    "enabled": true,
    "protected_prefixes": [
      "/admin",
      "/api/internal"
    ],
    "fail_closed": true,
    "issuers": [
      {
        "issuer": "https://auth.example.com/",
        "audience": "csf-api",
        "allowed_algs": [
          "RS256"
        ],
        "jwks_url": "https://auth.example.com/.well-known/jwks.json",
        "jwks_ttl_seconds": 600,
        "jwks_min_refresh_interval_seconds": 30,
        "leeway_seconds": 0
      }
    ]
  },
  "decision": {
    "short_circuit_on_block": true,
    "max_block_rate_pct": 5.0,
    "budget_min_samples": 200,
    "budget_window": 2000
  },
  "rate_limit": {
    "enabled": false,
    "rate_per_second": 50.0,
    "burst": 100.0,
    "max_tracked_principals": 100000
  },
  "circuit_breaker": {
    "enabled": true,
    "trip_threshold_pct": 25.0,
    "min_samples": 50,
    "window": 500,
    "cooldown_seconds": 30.0
  },
  "s1": {
    "enabled": true,
    "score_field": "attack",
    "tau_high": 11.0,
    "tau_low": 4.0
  },
  "s3": {
    "enabled": false,
    "model_path": "model/artifacts/s3_model.pkl",
    "trained_on_this_application": false,
    "advisory_only": true,
    "tau_block": 0.99,
    "tau_flag": 0.8
  },
  "_s3_note": "S3 ships OFF. It does not generalise (frozen-holdout AUC 0.66, ADR-0008). Enable ONLY after training on your own traffic (scripts/train_s3.py) and calibrating (scripts/calibrate.py); it stays advisory_only unless you validate a per-app model."
}
